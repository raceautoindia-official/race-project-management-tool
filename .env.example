# Copy to .env.local and fill in real values.

# --- MySQL connection ---
# If you use the bundled docker-compose.yml, these match its defaults:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=pm_app

# --- Auth ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=pm_session

# --- Parent Attendance app DB (identity source) ---
# Login credentials are federated to the Attendance app: users sign in with
# their Employee ID + PIN, validated against attendance.employees. Point these
# at that database (same MySQL server if co-located on one VPS). A read-only
# MySQL user with SELECT on attendance.employees is recommended for production.
ATTENDANCE_DB_HOST=localhost
ATTENDANCE_DB_PORT=3306
ATTENDANCE_DB_USER=root
ATTENDANCE_DB_PASSWORD=replace-with-attendance-db-password
# On the Race install this schema is called `attendance_db`, not `attendance`.
ATTENDANCE_DB_NAME=attendance_db

# --- Email (AWS SES) ---
# A verified SES sender identity + IAM creds allowed to ses:SendEmail.
# Leave blank to disable email (due-date alerts / meeting reminders become
# in-app-only). SES_REGION falls back to AWS_REGION, etc.
# Two ways to send. SMTP wins when both are set.
#
# SMTP — an ordinary company mailbox. Nothing to set up in DNS: your domain
# already lists its own mail server in SPF, so the mail is trusted straight
# away. Fastest route, and the right one unless you send thousands a day.
# The From address must be a real mailbox you can log in to; most providers
# refuse to send as anything else.
#   GoDaddy:        smtpout.secureserver.net, port 465
#   Google Workspace: smtp.gmail.com, port 465 (needs an App Password)
#   Microsoft 365:  smtp.office365.com, port 587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Leave blank to derive from the port (465 = true, otherwise STARTTLS).
SMTP_SECURE=

# AWS SES — for higher volume. Needs the domain verified, DKIM records added,
# amazonses.com in your SPF, and production access (new accounts are limited
# to verified recipients).
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=alerts@yourdomain.com

# --- Cron ---
# Shared secret required (header x-cron-secret) to trigger /api/cron/* jobs.
CRON_SECRET=replace-with-a-long-random-string
# Absolute base URL used to build links inside notification emails AND the
# calendar subscription links. It must be the public https address staff type
# into their browser: Google and Microsoft fetch the calendar feed from their
# own servers, so localhost or a LAN address here means those subscriptions
# silently never fill in. Profile → Calendar subscription → "Check it works"
# reports what this is currently set to.
APP_BASE_URL=https://projectmanager.raceinnovations.in

# --- Web Push (VAPID) — out-of-app browser notifications ---
# Generate once with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_*); keep PRIVATE secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Meetings app (video calls) ---
# Room links are created as <MEETINGS_APP_URL>/meeting/<room-id>. People sign
# in to that app once; it sends them back to the room.
MEETINGS_APP_URL=https://meetings.raceinnovations.in

# --- Inbound integration (the Attendance app reading PM) ---
# The key another company app must send as `x-integration-key` to call
# /api/integrations/*. Blank = those endpoints are off (503). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY=

# --- WhatsApp alerts (Meta WhatsApp Cloud API) ---
# Blank = WhatsApp is off (in-app + email notifications only). Staff also have
# to add a number and opt in on their profile page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of the approved message template with ONE body parameter. Meta only
# delivers business-initiated messages through a template; without this, plain
# text is sent (which only works inside a 24-hour reply window — for testing).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Country code added to numbers typed without one (91 = India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Shared secret for creating meetings in the meetings app directly (its
# INTEGRATION_API_KEY). Blank = PMApp only generates room links, and the room
# is created when the first person joins.
MEETINGS_API_KEY=
